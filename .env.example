# Copy to .env (`make setup` does this). Never commit .env.
# Defaults below are for LOCAL DEVELOPMENT ONLY - change every password before
# exposing any of these services beyond your laptop.

# ---- docker-compose infrastructure ----
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow
MONITORING_DB=monitoring
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MLFLOW_BUCKET=mlflow
# Official MinIO images were discontinued in late 2025; this is the maintained
# community fork build (https://github.com/pgsty/minio). Override if you prefer.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z

# Host ports (change if something else on your machine already uses them;
# macOS users: AirPlay Receiver occupies 5000 - set MLFLOW_PORT=5001).
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_PORT=5000
API_PORT=8000
MONITOR_PORT=8050

# ---- pipeline settings for commands run on the HOST (make train / retrain ...) ----
# Any config.yaml key can be overridden as PIPELINE_<SECTION>__<KEY>.
PIPELINE_MLFLOW__TRACKING_URI=http://localhost:5000
PIPELINE_MONITORING__DATABASE_URL=postgresql+psycopg://mlflow:mlflow@localhost:5432/monitoring
# PIPELINE_PROJECT__LOG_FORMAT=json
